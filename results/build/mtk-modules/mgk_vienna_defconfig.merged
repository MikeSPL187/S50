CONFIG_DRM_PANEL_MOT_DUMMY_CMD_60HZ=m

CONFIG_MOTO_CHG_TCMD_SUPPORT=m
CONFIG_CUSTOM_KERNEL_IMGSENSOR="mot_vienna_imx896_mipi_raw mot_vienna_s5kjd1_mipi_raw mot_vienna_gc13a2_mipi_raw mot_vienna_gc13a2_vcm_blad mot_vienna_s5k3k1_mipi_raw mot_paris_ov32b_mipi_raw"
