CONFIG_VIENNA_RW_CAMERA_DW9800SAF=y
#add for i2c tool
CONFIG_I2C_CHARDEV=y
CONFIG_MTK_EEPROM_PROJECT="vienna"
CONFIG_MOT_AK7377_HALL_TEST=y
CONFIG_MOT_TELE_DW9784_OIS_ALWAYS_IOVDD=y
CONFIG_INPUT_MISC_FPC1020_SAVE_TO_CLASS_DEVICE=y
CONFIG_AAC_RICHTAP_SUPPORT=y
