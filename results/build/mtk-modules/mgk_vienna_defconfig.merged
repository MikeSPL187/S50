CONFIG_WORK_AROUND_FOR_CHARGE_PANIC=y
CONFIG_WORK_AROUND_FOR_EN_DISVACDRV=y
CONFIG_MOTO_WLC_ALG_SUPPORT=m
#CONFIG_DISABLE_SUPPORT_MMI_ADAPTER=y
CONFIG_MOT_DW9784_AF_DRIFT=n

# CONFIG_SND_SOC_TFA9874 is not set
CONFIG_SND_SOC_TFA9865=m
CONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=y
CONFIG_INPUT_TOUCHSCREEN_MMI=y
CONFIG_GTP_USE_MMI_INFO=y
CONFIG_GTP_MULTI_CONFIG=y
CONFIG_TOUCHCLASS_MMI_MTK_CHARGER=y
